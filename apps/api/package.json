{
  "name": "@nebula/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de reservas de Nébula Dental (Hono + node:sqlite, TypeScript nativo en Node).",
  "type": "module",
  "engines": { "node": ">=22.13" },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "seed": "node src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
